{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "bun run clean && bash build.sh",
    "build:kit": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "clean": "rm -rf .svelte-kit build",
    "prepare": "svelte-kit sync",
    "check": "PUBLIC_SITE_URL=http://localhost:5173 svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:all": "bun run --sequential test test:browser"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.0",
    "@opentelemetry/api": "~1.9.0",
    "@playwright/test": "~1.62",
    "@rehype-pretty/transformers": "~0.13",
    "@sveltejs/adapter-static": "~3.0",
    "@sveltejs/kit": "~2.48",
    "@sveltejs/vite-plugin-svelte": "~6.2",
    "@tailwindcss/typography": "~0.5",
    "@tailwindcss/vite": "~4.1",
    "@types/mdast": "~4.0",
    "@types/node": "~24.10",
    "@types/unist": "~3.0",
    "eslint": "~9.39",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-svelte": "~3.13",
    "globals": "~17.11.0",
    "gray-matter": "~4.0",
    "lucide-svelte": "~0.553",
    "prettier": "~3.9.6",
    "prettier-plugin-svelte": "~4.1.1",
    "rehype-autolink-headings": "~7.1",
    "rehype-pretty-code": "~0.14",
    "rehype-slug": "~6.0",
    "rehype-stringify": "~10.0",
    "remark-gfm": "~4.0",
    "remark-github-blockquote-alert": "~2.0",
    "remark-parse": "~11.0",
    "remark-rehype": "~11.1",
    "svelte": "~5.43",
    "svelte-check": "~4.3",
    "tailwindcss": "~4.1",
    "typescript": "~5.9",
    "typescript-eslint": "~8.68.0",
    "unified": "~11.0",
    "unist-util-visit": "~5.0",
    "valibot": "~1.1",
    "vite": "~7.2"
  }
}
