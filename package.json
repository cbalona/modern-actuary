{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build:kit": "vite build",
    "build": "bun run clean && bash build.sh",
    "clean": "rm -rf .svelte-kit build",
    "preview": "vite preview",
    "fix": "eslint --fix .",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@antfu/eslint-config": "~6.7",
    "@rehype-pretty/transformers": "~0.13",
    "@sveltejs/adapter-static": "~3.0",
    "@sveltejs/kit": "~2.48",
    "@sveltejs/vite-plugin-svelte": "~6.2",
    "@tailwindcss/typography": "~0.5",
    "@tailwindcss/vite": "~4.1",
    "@types/mdast": "~4.0",
    "@types/node": "~24.10",
    "@types/unist": "~3.0",
    "eslint": "~9.39",
    "eslint-plugin-format": "~1.1",
    "eslint-plugin-svelte": "~3.13",
    "gray-matter": "~4.0",
    "lucide-svelte": "~0.553",
    "rehype-autolink-headings": "~7.1",
    "rehype-pretty-code": "~0.14",
    "rehype-slug": "~6.0",
    "rehype-stringify": "~10.0",
    "remark-gfm": "~4.0",
    "remark-github-blockquote-alert": "~2.0",
    "remark-parse": "~11.0",
    "remark-rehype": "~11.1",
    "svelte": "~5.43",
    "svelte-check": "~4.3",
    "svelte-eslint-parser": "~1.4",
    "tailwindcss": "~4.1",
    "typescript": "~5.9",
    "unified": "~11.0",
    "unist-util-visit": "~5.0",
    "valibot": "~1.1",
    "vite": "~7.2"
  }
}
