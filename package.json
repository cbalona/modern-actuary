{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "bun run clean && bash build.sh",
    "build:kit": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "clean": "rm -rf .svelte-kit build",
    "prepare": "svelte-kit sync",
    "check": "PUBLIC_SITE_URL=http://localhost:5173 svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:all": "bun run --sequential test test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@playwright/test": "^1.62.1",
    "@rehype-pretty/transformers": "~0.13.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "~0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/unist": "^3.0.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "lucide-svelte": "~1.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "~0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "valibot": "^1.4.2",
    "vite": "^8.2.2"
  }
}
